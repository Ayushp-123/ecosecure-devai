# ─────────────────────────────────────────────
# EcoSecure DevAI — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# GitLab instance URL (no trailing slash)
# Example: https://gitlab.com  or  https://gitlab.mycompany.com
GITLAB_URL=https://gitlab.com

# GitLab Personal Access Token
# Needs scopes: api, read_repository, write_repository
# Create at: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key
# Create at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port for the backend server
PORT=3001

# Optional: Webhook secret token (must match GitLab webhook secret)
# Leave empty to disable signature verification during development
WEBHOOK_SECRET=

# Optional: GitLab default branch (used as base for fix branches)
# Defaults to "main" if not set
DEFAULT_BRANCH=main
